{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/hooks/gd_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/hooks/unity_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/hooks/unity_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
